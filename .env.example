# ── Database ──
DATABASE_URL=postgresql://localhost:5432/infinite_canvas

# ── 账号中心 (account-center) 对接 ──
# IC 已退役本地登录/积分, 全量改用账号中心统一身份 + 钱包。
AC_BASE_URL=https://account.mirainya.icu
AC_CLIENT_ID=infinite_canvas
AC_CLIENT_SECRET=向账号中心运营申请的密钥
AC_ISSUER=account-center
# IC 管理端白名单(账号中心用户名, 逗号分隔), 命中才放行 /api/admin
IC_ADMINS=

# ── CORS (comma-separated origins, leave empty for default dev origins) ──
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# ── Server ──
# PORT=7391
APP_ENV=development
PLUGIN_HOT_RELOAD=true
V2_EMBEDDED_WORKER=true
# tldraw 正式商用许可证；本地开发可留空
VITE_TLDRAW_LICENSE_KEY=
